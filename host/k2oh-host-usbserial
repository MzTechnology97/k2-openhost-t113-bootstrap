#!/bin/sh
# K2-OpenHost host-side binding for the T113 Generic Serial gadget.
#
# The T113 exposes three configfs gser functions as 0525:a4a6. Linux's
# usbserial generic driver does not claim arbitrary vendor-specific devices
# unless a VID/PID is supplied, so a fresh host boot may enumerate the USB
# gadget but never create ttyUSB0..2. This utility makes that binding
# persistent and can bind an already-present gadget without rebooting.
set -eu

VID="${K2OH_GADGET_VID:-0525}"
PID="${K2OH_GADGET_PID:-a4a6}"
ETC_ROOT="${K2OH_ETC_ROOT:-/etc}"
SYS_ROOT="${K2OH_SYS_ROOT:-/sys}"
DEV_ROOT="${K2OH_DEV_ROOT:-/dev}"
ALLOW_NONROOT="${K2OH_ALLOW_NONROOT:-0}"
SKIP_RUNTIME="${K2OH_SKIP_RUNTIME:-0}"

MODPROBE_CONF="${ETC_ROOT}/modprobe.d/k2-openhost-gadget-serial.conf"
MODULES_CONF="${ETC_ROOT}/modules-load.d/k2-openhost-gadget-serial.conf"
NEW_ID="${SYS_ROOT}/bus/usb-serial/drivers/generic/new_id"

usage() {
    cat <<EOF
usage: k2oh-host-usbserial install|status|remove

  install  persist usbserial 0525:a4a6 binding and bind the live gadget now
  status   show persisted configuration, driver state and ttyUSB channels
  remove   remove only the persistent configuration (does not unload driver)
EOF
}

need_root() {
    if [ "${ALLOW_NONROOT}" != "1" ] && [ "$(id -u)" -ne 0 ]; then
        echo "k2oh-host-usbserial: run this command as root" >&2
        exit 1
    fi
}

tty_count() {
    count=0
    for dev in "${DEV_ROOT}"/ttyUSB*; do
        [ -e "${dev}" ] || continue
        count=$((count + 1))
    done
    echo "${count}"
}

gadget_present() {
    for dev in "${SYS_ROOT}"/bus/usb/devices/*; do
        [ -r "${dev}/idVendor" ] || continue
        [ -r "${dev}/idProduct" ] || continue
        vendor=$(cat "${dev}/idVendor" 2>/dev/null || true)
        product=$(cat "${dev}/idProduct" 2>/dev/null || true)
        [ "${vendor}" = "${VID}" ] && [ "${product}" = "${PID}" ] && return 0
    done
    return 1
}

write_configs() {
    mkdir -p "$(dirname "${MODPROBE_CONF}")" "$(dirname "${MODULES_CONF}")"
    cat >"${MODPROBE_CONF}" <<EOF
# K2-OpenHost T113 Generic Serial gadget (three gser interfaces).
# Linux usbserial generic needs the gadget VID/PID explicitly.
options usbserial vendor=0x${VID} product=0x${PID}
EOF
    cat >"${MODULES_CONF}" <<EOF
# K2-OpenHost T113 Generic Serial gadget.
usbserial
EOF
}

bind_now() {
    [ "${SKIP_RUNTIME}" = "1" ] && return 0

    command -v modprobe >/dev/null 2>&1 || {
        echo "k2oh-host-usbserial: modprobe not found" >&2
        return 1
    }

    # When usbserial is not loaded, the module options claim 0525:a4a6.
    # When it is already loaded without those options, new_id attaches the
    # generic driver to the currently enumerated gadget without unloading any
    # serial users.
    modprobe usbserial "vendor=0x${VID}" "product=0x${PID}"
    if [ -e "${NEW_ID}" ]; then
        printf '%s %s\n' "${VID}" "${PID}" >"${NEW_ID}" 2>/dev/null || true
    fi

    command -v udevadm >/dev/null 2>&1 && udevadm settle || true

    if gadget_present; then
        i=0
        while [ "$(tty_count)" -lt 3 ] && [ "${i}" -lt 30 ]; do
            sleep 0.1
            i=$((i + 1))
        done
        if [ "$(tty_count)" -lt 3 ]; then
            echo "k2oh-host-usbserial: 0525:a4a6 is present but fewer than three ttyUSB channels appeared" >&2
            return 1
        fi
    fi
}

show_status() {
    echo "K2-OpenHost T113 USB serial host binding"
    echo "  VID:PID: ${VID}:${PID}"
    echo "  modprobe config: ${MODPROBE_CONF} $([ -f "${MODPROBE_CONF}" ] && echo present || echo missing)"
    echo "  modules-load:    ${MODULES_CONF} $([ -f "${MODULES_CONF}" ] && echo present || echo missing)"
    echo "  usbserial:       $([ -d "${SYS_ROOT}/module/usbserial" ] && echo loaded || echo not-loaded)"
    echo "  gadget:          $(gadget_present && echo present || echo not-present)"
    echo "  ttyUSB channels: $(tty_count)"
    for dev in "${DEV_ROOT}"/ttyUSB*; do
        [ -e "${dev}" ] || continue
        echo "    ${dev}"
    done
}

install_binding() {
    need_root
    write_configs
    bind_now
    show_status
}

remove_binding() {
    need_root
    rm -f "${MODPROBE_CONF}" "${MODULES_CONF}"
    echo "k2oh-host-usbserial: persistent binding removed"
    echo "The currently loaded usbserial driver was left untouched."
}

case "${1:-}" in
    install) install_binding ;;
    status) show_status ;;
    remove) remove_binding ;;
    *) usage; exit 2 ;;
esac
