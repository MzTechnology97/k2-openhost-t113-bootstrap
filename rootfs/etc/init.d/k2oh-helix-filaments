#!/bin/sh /etc/rc.common
# K2-OpenHost: HelixScreen lists only the external host's filament library
# (k2oh-helix-filaments). Reads Moonraker; never touches a running print.
# Off with HELIX_FILAMENTS=off in /mnt/UDISK/.k2openhost/k2openhost.conf;
# `k2oh-helix-filaments --restore` puts HelixScreen's own catalog back.

START=98
STOP=08
USE_PROCD=1

start_service() {
	[ -f /mnt/UDISK/.k2openhost/k2openhost.conf ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/bin/k2oh-helix-filaments
	procd_set_param respawn 3600 30 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
