#!/bin/sh
# K2-OpenHost slot B: start the K2 boards at boot, then the bridges.
#
# Slot A runs Creality's /etc/init.d/mcu_update (S13) at boot. In slot B it is
# not linked in rc.d, because on the first boot on a printer procd ran it while
# the bridges (S56) were already reading the same UARTs: the bridges took
# mcu_util's answers, the handshake failed and the boards stayed in Creality's
# loader. After a reboot of the T113 alone the MCU rail also stays on, and the
# boards keep the configuration of the previous host session, which Klipper
# cannot reset.
#
# So, one step after the other:
#   1. power-cycle the MCU rail (stock mcu_reset.sh): every board starts from
#      its loader, as after a power-on;
#   2. run the stock mcu_update: it starts every board and reflashes any whose
#      version differs from slot B's firmware files;
#   3. start the bridges.
# The rc.d order is not a guarantee here: procd does not wait for board_init
# (S20), which exports GPIO140 with "mcu_reset.sh enable", and on the second
# printer boot GPIO140 did not exist yet when this script ran. So step 1 runs
# "mcu_reset.sh enable" itself first (export, output, rail on), and steps 1-2
# run once more when the Main or Nozzle MCU did not answer mcu_update.
# /tmp/k2oh-mcu.ready holds mcu_update's exit code once step 2 is over.
#
# The CFS is never flashed here: mcu_util_485 flashes a CFS whenever
# fw/cfs/version.json lists another version for it, so that list stays empty
# and the real one waits in version.json.k2oh for 'k2oh-mcu-fw apply --cfs'.

READY=/tmp/k2oh-mcu.ready
RESET=/usr/bin/mcu_reset.sh
CFS_FW=/usr/share/klipper/fw/cfs

log() {
	logger -t k2oh-mcu "$*"
	echo "k2oh-mcu: $*"
}

power_cycle() {
	if [ ! -x "$RESET" ]; then
		log "no $RESET: the MCU rail is not cycled"
		return 1
	fi
	"$RESET" enable || log "$RESET enable failed (exit $?)"
	log "power-cycling the MCU rail"
	"$RESET" || { log "$RESET failed (exit $?)"; return 1; }
	sleep 1
}

hold_cfs_list() {
	[ -d "$CFS_FW" ] || return 0
	if grep -q boot_ver "$CFS_FW/version.json" 2>/dev/null; then
		mv "$CFS_FW/version.json" "$CFS_FW/version.json.k2oh" \
			&& log "CFS firmware list put aside: the CFS is flashed only by 'k2oh-mcu-fw apply --cfs'"
	fi
	[ -f "$CFS_FW/version.json" ] || printf '{"CFSs": []}\n' > "$CFS_FW/version.json"
}

# True when mcu_update read a version from both the Main and the Nozzle MCU.
boards_answered() {
	grep -q '"mcu0": { "serial": "[^"]*", "version": "[^"]' /tmp/.mcu_version 2>/dev/null \
		&& grep -q '"noz0": { "serial": "[^"]*", "version": "[^"]' /tmp/.mcu_version 2>/dev/null
}

start_boards() {
	power_cycle
	log "running the stock mcu_update (it can take minutes when it flashes)"
	/etc/init.d/mcu_update start
	rc=$?
	log "mcu_update exit $rc, versions: $(tr -d '\n' < /tmp/.mcu_version 2>/dev/null)"
}

rm -f "$READY"
hold_cfs_list
start_boards
if ! boards_answered; then
	log "the Main or Nozzle MCU did not answer: once more"
	start_boards
	boards_answered || log "the Main or Nozzle MCU still did not answer; see /tmp/mcu_update.log"
fi
echo "$rc" > "$READY"

log "starting the bridges"
/etc/init.d/k2oh-bridge start || log "the bridges did not start (exit $?)"
