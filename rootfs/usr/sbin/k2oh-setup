#!/usr/bin/python3
"""K2-OpenHost slot B setup: point the T113 at the external host.

    k2oh-setup                 apply /mnt/UDISK/.k2openhost/k2openhost.conf
    k2oh-setup --host IP       change the external host and apply
    k2oh-setup status          show the configuration
    k2oh-setup helix-update ARCHIVE
                               replace HelixScreen with a release archive
                               (printer idle only; the old one is saved)
    k2oh-setup helix-restore   put the last saved HelixScreen back

The configuration is written by the host installer (helper.sh, T113 menu):

    HOST_IP=192.168.1.50
    MOONRAKER_PORT=7125
    HELIX_ARCHIVE=/mnt/UDISK/.k2openhost/setup/helixscreen-k2-v1.0.2.tar.gz
    HELIX_INSTALLER=/mnt/UDISK/.k2openhost/setup/helixscreen-install.sh

Applying it installs HelixScreen from the local archive (once) and points it
at Moonraker on the external host; k2oh-mcu-fw reads the same file to check
that Klipper on the host is stopped before flashing. The first boot of slot
B runs this automatically (/etc/init.d/k2oh-firstboot).
"""

import ipaddress
import json
import os
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request

K2OH_DIR = "/mnt/UDISK/.k2openhost"
CONF = os.path.join(K2OH_DIR, "k2openhost.conf")
DONE = os.path.join(K2OH_DIR, "setup.done")
HELIX_SETTINGS = (
    "/mnt/UDISK/helixscreen/config/settings.json",
    "/opt/helixscreen/config/settings.json",
    "/mnt/UDISK/printer_data/config/helixscreen/settings.json",
)
HELIX_INIT = "/etc/init.d/S99helixscreen"


def log(msg):
    print("%s k2oh-setup: %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg), flush=True)


def read_conf():
    conf = {}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, value = line.split("=", 1)
                    conf[key.strip()] = value.strip()
    except OSError:
        pass
    return conf


def write_conf(conf):
    os.makedirs(K2OH_DIR, exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        f.write("# K2-OpenHost slot B configuration (k2oh-setup)\n")
        for key in sorted(conf):
            f.write("%s=%s\n" % (key, conf[key]))
    os.replace(tmp, CONF)


def valid_host(value):
    try:
        ipaddress.ip_address(value)
        return True
    except ValueError:
        return all(c.isalnum() or c in ".-" for c in value) and 0 < len(value) < 254


def helix_installed():
    return os.path.exists(HELIX_INIT) or any(os.path.exists(p) for p in HELIX_SETTINGS)


def install_helix(conf):
    archive = conf.get("HELIX_ARCHIVE", "")
    installer = conf.get("HELIX_INSTALLER", "")
    if helix_installed():
        log("HelixScreen is already installed")
        return True
    if not archive:
        log("no HelixScreen archive prepared; skipping")
        return True
    if not (os.path.isfile(archive) and os.path.isfile(installer)):
        log("HelixScreen archive or installer missing: %s, %s" % (archive, installer))
        return False
    log("installing HelixScreen from %s" % os.path.basename(archive))
    result = subprocess.run(["sh", installer, "--local", archive, "--skip-kiauh-registration"],
                            stdin=subprocess.DEVNULL)
    if result.returncode != 0:
        log("HelixScreen installer failed (exit %d)" % result.returncode)
        return False
    return True


def point_helix(host, port):
    changed = False
    for path in HELIX_SETTINGS:
        if not os.path.isfile(path):
            continue
        try:
            with open(path) as f:
                data = json.load(f)
        except (OSError, ValueError):
            data = {}
        if not isinstance(data, dict):
            data = {}
        active = data.get("active_printer_id") or "default"
        data["active_printer_id"] = active
        printers = data.setdefault("printers", {})
        printer = printers.setdefault(active, {})
        printer["moonraker_host"] = host
        printer["moonraker_port"] = int(port)
        tmp = path + ".k2oh"
        with open(tmp, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        os.replace(tmp, path)
        log("HelixScreen now uses Moonraker at %s:%s (%s)" % (host, port, path))
        changed = True
    changed = point_helix_wait(host, port) or changed
    if changed and os.path.exists(HELIX_INIT):
        restart_helix()
    elif not changed:
        log("HelixScreen settings not found yet; it will ask for the host in its setup wizard")
    return changed


HELIX_BIN = "/opt/helixscreen/bin/"
HELIX_PROCESSES = ("helix-launcher.sh", "helix-watchdog", "helix-screen", "helix-splash")


def helix_pids(proc="/proc"):
    """PIDs of HelixScreen's launcher, watchdog, UI and splash."""
    names = {HELIX_BIN + name for name in HELIX_PROCESSES}
    pids = []
    for entry in os.listdir(proc):
        if not entry.isdigit() or int(entry) == os.getpid():
            continue
        try:
            with open(os.path.join(proc, entry, "cmdline"), "rb") as f:
                argv = f.read().split(b"\0")
        except OSError:
            continue
        # the launcher is "/bin/sh /opt/helixscreen/bin/helix-launcher.sh"
        if any(arg.decode("utf-8", "replace") in names for arg in argv[:2]):
            pids.append(int(entry))
    return pids


def restart_helix(proc="/proc", wait=5.0):
    """Stop HelixScreen, end whatever the stop left, start it again.

    On the first boot S99helixscreen and k2oh-firstboot start together, and a
    plain "restart" while HelixScreen was still starting left its first
    launcher running: two watchdogs then fought over one screen ("Another
    instance of helix-screen is already running").
    """
    stop_helix(proc, wait)
    subprocess.run([HELIX_INIT, "start"], stdin=subprocess.DEVNULL)


def stop_helix(proc="/proc", wait=5.0):
    subprocess.run([HELIX_INIT, "stop"], stdin=subprocess.DEVNULL)
    pids = helix_pids(proc)
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for pid in pids:
            try:
                os.kill(pid, sig)
            except OSError:
                pass
        deadline = time.monotonic() + wait
        while pids and time.monotonic() < deadline:
            time.sleep(0.2)
            pids = [pid for pid in pids if os.path.exists(os.path.join(proc, str(pid)))]
        if not pids:
            break
    if pids:
        log("HelixScreen processes still running after SIGKILL: %s" % pids)


WAIT_MARK = "# k2oh-setup: Moonraker runs on the external host"


def point_helix_wait(host, port):
    """Make HelixScreen's boot wait poll Moonraker on the external host.

    Its K2 hook waits up to 120 s for http://127.0.0.1:7125 before starting
    the UI, and slot B has no local Moonraker. The hook reads
    HELIX_MOONRAKER_READY_URL; its init script does not load helixscreen.env,
    so the export goes into the init script itself, on a marked line.
    """
    try:
        with open(HELIX_INIT) as f:
            lines = f.read().split("\n")
    except OSError:
        return False
    line = 'export HELIX_MOONRAKER_READY_URL="http://%s:%s/server/info"  %s' % (host, port, WAIT_MARK)
    kept = [x for x in lines if not x.endswith(WAIT_MARK)]
    if not kept or not kept[0].startswith("#!"):
        log("%s has no shebang line; HelixScreen keeps its local Moonraker wait" % HELIX_INIT)
        return False
    new = kept[:1] + [line] + kept[1:]
    if new == lines:
        return False
    target = os.path.realpath(HELIX_INIT)
    tmp = target + ".k2oh"
    with open(tmp, "w") as f:
        f.write("\n".join(new))
    os.chmod(tmp, os.stat(target).st_mode & 0o7777)
    os.replace(tmp, target)
    log("HelixScreen's boot wait now polls Moonraker at %s:%s" % (host, port))
    return True


USTREAMER_INIT = "/etc/init.d/ustreamer"


def disable_helix_camera(init=None, rc_dir="/etc/rc.d"):
    """Stop the camera server HelixScreen's K2 installer sets up.

    The installer always serves /dev/video0 with ustreamer, but in OpenHost
    mode the cameras are wired to the external host: on the T113 it only
    retries a missing device and kills cam_app every few seconds.
    """
    init = init or USTREAMER_INIT
    try:
        enabled = any(name.endswith("ustreamer") for name in os.listdir(rc_dir))
    except OSError:
        enabled = False
    if not (os.path.exists(init) and enabled):
        return False
    subprocess.run([init, "stop"], stdin=subprocess.DEVNULL)
    subprocess.run([init, "disable"], stdin=subprocess.DEVNULL)
    log("HelixScreen's camera server disabled (cameras are on the external host)")
    return True


HELIX_DIR = "/opt/helixscreen"
HELIX_SERVICE = "/etc/init.d/helixscreen"
HELIX_BACKUPS = os.path.join(K2OH_DIR, "helix-backup")
IDLE_STATES = ("standby", "complete", "cancelled", "error")


def print_state(conf):
    url = conf.get("MOONRAKER_URL") or "http://%s:%s" % (
        conf.get("HOST_IP", ""), conf.get("MOONRAKER_PORT", "7125"))
    try:
        with urllib.request.urlopen(url + "/printer/objects/query?print_stats=state",
                                    timeout=10) as r:
            return json.load(r)["result"]["status"]["print_stats"]["state"]
    except (OSError, ValueError, KeyError, TypeError):
        return "unreachable"


def helix_swap_allowed(conf):
    """HelixScreen is replaced only while the printer is idle; a host that
    does not answer may still be printing."""
    state = print_state(conf)
    if state in IDLE_STATES:
        return True
    log("printer state is %s: HelixScreen is replaced only while it is idle" % state)
    return False


def save_helix(dest):
    """Copy the installed HelixScreen (config included) and its init scripts."""
    os.makedirs(os.path.join(dest, "init.d"))
    shutil.copytree(HELIX_DIR, os.path.join(dest, "helixscreen"), symlinks=True)
    for path in (HELIX_INIT, HELIX_SERVICE):
        if os.path.isfile(path):
            shutil.copy2(path, os.path.join(dest, "init.d"))


def update_helix(conf, archive):
    """Install a HelixScreen release archive over the running one.

    The release's own installer runs in --update mode (it keeps config/ and
    rewrites the init scripts), then the K2-OpenHost changes are put back:
    the boot wait on the external Moonraker, and no camera server.
    """
    if not os.path.isfile(archive):
        log("HelixScreen archive not found: %s" % archive)
        return 1
    if not helix_swap_allowed(conf):
        return 1
    backup = os.path.join(HELIX_BACKUPS, time.strftime("%Y%m%d-%H%M%S"))
    save_helix(backup)
    log("installed HelixScreen saved to %s" % backup)
    with tempfile.TemporaryDirectory() as work:
        installer = os.path.join(work, "install.sh")
        with tarfile.open(archive) as tar, open(installer, "wb") as f:
            f.write(tar.extractfile("helixscreen/install.sh").read())
        result = subprocess.run(["sh", installer, "--update", "--local", archive,
                                 "--skip-kiauh-registration"], stdin=subprocess.DEVNULL)
    if result.returncode != 0:
        log("HelixScreen installer failed (exit %d); `k2oh-setup helix-restore` "
            "puts the saved one back" % result.returncode)
        return 1
    point_helix(conf.get("HOST_IP", ""), conf.get("MOONRAKER_PORT", "7125"))
    disable_helix_camera()
    log("HelixScreen updated from %s" % os.path.basename(archive))
    return 0


def restore_helix(conf):
    """Put the last saved HelixScreen back; the replaced one goes to trash/."""
    try:
        backup = os.path.join(HELIX_BACKUPS, sorted(os.listdir(HELIX_BACKUPS))[-1])
    except (OSError, IndexError):
        log("no saved HelixScreen in %s" % HELIX_BACKUPS)
        return 1
    if not helix_swap_allowed(conf):
        return 1
    stop_helix()
    trash = os.path.join(K2OH_DIR, "trash", "helixscreen-" + time.strftime("%Y%m%d-%H%M%S"))
    os.makedirs(os.path.dirname(trash), exist_ok=True)
    shutil.move(HELIX_DIR, trash)
    shutil.copytree(os.path.join(backup, "helixscreen"), HELIX_DIR, symlinks=True)
    for name in os.listdir(os.path.join(backup, "init.d")):
        shutil.copy2(os.path.join(backup, "init.d", name), os.path.dirname(HELIX_INIT))
    disable_helix_camera()
    subprocess.run([HELIX_INIT, "start"], stdin=subprocess.DEVNULL)
    log("HelixScreen restored from %s; the replaced one is in %s" % (backup, trash))
    return 0


TOKEN = os.path.join(K2OH_DIR, "ctl.token")


def ensure_token():
    """k2oh-ctl's shared secret (normally written by install-slot-b.sh)."""
    try:
        with open(TOKEN) as f:
            if len(f.read().strip()) >= 16:
                return False
    except OSError:
        pass
    import secrets
    fd = os.open(TOKEN, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(secrets.token_urlsafe(24) + "\n")
    log("created %s for k2oh-ctl; copy it to the external host" % TOKEN)
    return True


def apply(conf):
    host = conf.get("HOST_IP", "")
    port = conf.get("MOONRAKER_PORT", "7125")
    if not valid_host(host):
        log("HOST_IP is missing or invalid in %s" % CONF)
        return 1
    if conf.get("MOONRAKER_URL") != "http://%s:%s" % (host, port):
        conf["MOONRAKER_URL"] = "http://%s:%s" % (host, port)
        write_conf(conf)
    log("external host: %s (Moonraker %s)" % (host, conf["MOONRAKER_URL"]))
    ensure_token()
    if os.path.exists("/etc/init.d/k2oh-ctl"):
        # k2oh-ctl reads HOST_IP and the token at start.
        subprocess.run(["/etc/init.d/k2oh-ctl", "restart"], stdin=subprocess.DEVNULL)
    helix_ok = install_helix(conf)
    point_helix(host, port)
    disable_helix_camera()
    if not helix_ok:
        log("setup incomplete: HelixScreen is retried at the next boot (or run k2oh-setup)")
        return 1
    with open(DONE, "w") as f:
        f.write(time.strftime("%Y-%m-%dT%H:%M:%S\n"))
    log("done")
    return 0


def main():
    if os.geteuid() != 0:
        print("k2oh-setup: run as root", file=sys.stderr)
        return 1
    args = sys.argv[1:]
    conf = read_conf()
    if args[:1] == ["status"]:
        print("Configuration : %s" % (CONF if conf else "missing"))
        for key in sorted(conf):
            print("  %s=%s" % (key, conf[key]))
        print("Setup         : %s" % ("done" if os.path.exists(DONE) else "pending"))
        print("HelixScreen   : %s" % ("installed" if helix_installed() else "not installed"))
        return 0
    if args[:1] == ["helix-update"] and len(args) == 2:
        return update_helix(conf, args[1])
    if args == ["helix-restore"]:
        return restore_helix(conf)
    if args[:1] == ["--host"] and len(args) == 2:
        if not valid_host(args[1]):
            print("k2oh-setup: invalid host %r" % args[1], file=sys.stderr)
            return 2
        conf["HOST_IP"] = args[1]
        conf.setdefault("MOONRAKER_PORT", "7125")
        write_conf(conf)
    elif args:
        print(__doc__.strip().split("\n\n")[1], file=sys.stderr)
        return 2
    return apply(conf)


if __name__ == "__main__":
    sys.exit(main())
